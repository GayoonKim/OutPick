rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null;
    }

    function moderationAccountPath(uid) {
      return /databases/(default)/documents/moderationAccounts/$(uid);
    }

    function hasModerationProjection() {
      return signedIn()
        && firestore.exists(moderationAccountPath(request.auth.uid));
    }

    function moderationRestrictionExpired() {
      return hasModerationProjection()
        && firestore.get(moderationAccountPath(request.auth.uid)).data.moderationStatus == "restricted"
        && "restrictedUntil" in firestore.get(moderationAccountPath(request.auth.uid)).data
        && firestore.get(moderationAccountPath(request.auth.uid)).data.restrictedUntil is timestamp
        && firestore.get(moderationAccountPath(request.auth.uid)).data.restrictedUntil <= request.time;
    }

    function canReadAppContent() {
      return hasModerationProjection()
        && (
          firestore.get(moderationAccountPath(request.auth.uid)).data.moderationStatus in ["active", "restricted"]
          || moderationRestrictionExpired()
        );
    }

    function canCreateUGC() {
      return hasModerationProjection()
        && (
          firestore.get(moderationAccountPath(request.auth.uid)).data.moderationStatus == "active"
          || moderationRestrictionExpired()
        );
    }

    function isAccountActive() {
      return signedIn()
        && hasModerationProjection()
        && firestore.get(moderationAccountPath(request.auth.uid)).data.accountStatus == "active"
        && canCreateUGC();
    }

    function isReadableAccount() {
      return signedIn()
        && hasModerationProjection()
        && firestore.get(moderationAccountPath(request.auth.uid)).data.accountStatus == "active"
        && canReadAppContent();
    }

    function roomPath(roomID) {
      return /databases/(default)/documents/Rooms/$(roomID);
    }

    function mediaUploadPath(roomID, messageID) {
      return /databases/(default)/documents/Rooms/$(roomID)/MediaUploads/$(messageID);
    }

    function hasValidMediaUploadReservation(roomID, messageID, kind) {
      return signedIn()
        && roomIsActive(roomID)
        && firestore.exists(mediaUploadPath(roomID, messageID))
        && firestore.get(mediaUploadPath(roomID, messageID)).data.senderUID == request.auth.uid
        && firestore.get(mediaUploadPath(roomID, messageID)).data.kind == kind
        && firestore.get(mediaUploadPath(roomID, messageID)).data.status == "pending"
        && firestore.get(mediaUploadPath(roomID, messageID)).data.storagePrefix == "rooms/" + roomID + "/messages/" + messageID
        && firestore.get(mediaUploadPath(roomID, messageID)).data.expiresAt is timestamp
        && firestore.get(mediaUploadPath(roomID, messageID)).data.expiresAt > request.time;
    }

    function roomIsActive(roomID) {
      return firestore.exists(roomPath(roomID))
        && firestore.get(roomPath(roomID)).data.isClosed != true
        && (
          !("lifecycleStatus" in firestore.get(roomPath(roomID)).data)
          || firestore.get(roomPath(roomID)).data.lifecycleStatus == "active"
        );
    }

    function isRoomCreator(roomID) {
      return signedIn()
        && firestore.exists(roomPath(roomID))
        && firestore.get(roomPath(roomID)).data.creatorUID == request.auth.uid;
    }

    function totalBrandAdminPath(uid) {
      return /databases/(default)/documents/brandAdmins/$(uid);
    }

    function isTotalBrandAdmin() {
      return isAccountActive()
        && firestore.exists(totalBrandAdminPath(request.auth.uid))
        && firestore.get(totalBrandAdminPath(request.auth.uid)).data.isActive == true;
    }

    function brandManagerPath(brandID, uid) {
      return /databases/(default)/documents/brands/$(brandID)/admins/$(uid);
    }

    function hasBrandManagerAccess(brandID) {
      return isAccountActive()
        && firestore.exists(brandManagerPath(brandID, request.auth.uid))
        && firestore.get(brandManagerPath(brandID, request.auth.uid)).data.role in ["owner", "admin"];
    }

    function hasBrandWriteAccess(brandID) {
      return signedIn()
        && (isTotalBrandAdmin() || hasBrandManagerAccess(brandID));
    }

    function isImageUpload(maxBytes) {
      return request.resource != null
        && request.resource.size > 0
        && request.resource.size <= maxBytes
        && request.resource.contentType.matches('image/.*');
    }

    function isJpegUpload(maxBytes) {
      return request.resource != null
        && request.resource.size > 0
        && request.resource.size <= maxBytes
        && request.resource.contentType == 'image/jpeg';
    }

    function isVideoUpload(maxBytes) {
      return request.resource != null
        && request.resource.size > 0
        && request.resource.size <= maxBytes
        && request.resource.contentType in [
          'video/mp4',
          'video/quicktime',
          'video/x-m4v'
        ];
    }

    match /rooms/{roomID}/cover/thumb/{fileName} {
      allow get: if isReadableAccount() && roomIsActive(roomID);
      allow create, update: if isAccountActive() && isRoomCreator(roomID)
        && isJpegUpload(5 * 1024 * 1024);
      allow delete: if isAccountActive() && isRoomCreator(roomID);
      allow list: if false;
    }

    match /rooms/{roomID}/cover/original/{fileName} {
      allow get: if isReadableAccount() && roomIsActive(roomID);
      allow create, update: if isAccountActive() && isRoomCreator(roomID)
        && isJpegUpload(30 * 1024 * 1024);
      allow delete: if isAccountActive() && isRoomCreator(roomID);
      allow list: if false;
    }

    match /rooms/{roomID}/messages/{messageID}/images/{imageID}/{fileName} {
      allow read, write: if false;
    }

    match /rooms/{roomID}/messages/{messageID}/video/thumb.jpg {
      allow read, write: if false;
    }

    match /rooms/{roomID}/messages/{messageID}/video/{fileName} {
      allow read, write: if false;
    }

    match /rooms/{roomID}/messages/{messageID}/attachments/{attachmentID}/{variant} {
      // ready 파일 읽기는 서버 권한 검사 후 발급한 단기 서명 URL만 사용한다.
      allow get: if false;
      allow create, update, delete, list: if false;
    }

    match /profileImage/{userID}/{variant}/{fileName} {
      allow get: if isReadableAccount()
        && firestore.exists(moderationAccountPath(userID))
        && firestore.get(moderationAccountPath(userID)).data.accountStatus == "active";
      allow create, update: if isAccountActive()
        && request.auth.uid == userID
        && variant in ['thumb', 'original']
        && isImageUpload(30 * 1024 * 1024);
      allow delete: if isAccountActive() && request.auth.uid == userID;
      allow list: if false;
    }

    match /brands/{brandID}/{assetPath=**} {
      allow get: if isReadableAccount();
      allow create, update: if hasBrandWriteAccess(brandID)
        && (
          isImageUpload(30 * 1024 * 1024)
          || isVideoUpload(350 * 1024 * 1024)
        );
      allow delete: if hasBrandWriteAccess(brandID);
      allow list: if false;
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
