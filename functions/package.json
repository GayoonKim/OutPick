{
  "name": "functions",
  "scripts": {
    "clean": "node scripts/clean-lib.mjs",
    "lint": "eslint --ext .js,.ts .",
    "build": "npm run clean && tsc",
    "test": "npm run build && node scripts/run-tests.mjs",
    "seed:style-moods": "npm run build && node scripts/seed-style-moods.mjs",
    "audit:brand-chat-reset": "npm run build && node scripts/audit-brand-chat-reset.mjs",
    "audit:firebase-rules": "node scripts/audit-firebase-rules.mjs",
    "audit:firestore-indexes": "node scripts/audit-firestore-indexes.mjs",
    "backfill:moderation-principals": "npm run build && node scripts/backfill-moderation-principals.mjs",
    "backfill:account-capabilities": "npm run build && node scripts/backfill-account-capabilities.mjs",
    "reset:brand-chat-data": "npm run build && node scripts/reset-brand-chat-data.mjs",
    "build:watch": "tsc --watch",
    "serve": "npm run build && firebase emulators:start --only functions",
    "shell": "npm run build && firebase functions:shell",
    "start": "npm run shell",
    "deploy": "firebase deploy --only functions",
    "logs": "firebase functions:log"
  },
  "engines": {
    "node": "24"
  },
  "main": "lib/index.js",
  "dependencies": {
    "@google-cloud/tasks": "^6.2.2",
    "firebase-admin": "^13.10.0",
    "firebase-functions": "^7.2.5",
    "google-auth-library": "^9.15.1",
    "sharp": "^0.34.5"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^5.12.0",
    "@typescript-eslint/parser": "^5.12.0",
    "eslint": "^8.9.0",
    "eslint-config-google": "^0.14.0",
    "eslint-plugin-import": "^2.25.4",
    "firebase-functions-test": "^3.4.1",
    "typescript": "^5.7.3"
  },
  "private": true
}
