rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function userPath(uid) {
      return /databases/$(database)/documents/users/$(uid);
    }

    function moderationAccountPath(uid) {
      return /databases/$(database)/documents/moderationAccounts/$(uid);
    }

    function hasModerationProjection() {
      return signedIn()
        && exists(moderationAccountPath(request.auth.uid));
    }

    function moderationRestrictionExpired() {
      return hasModerationProjection()
        && get(moderationAccountPath(request.auth.uid)).data.moderationStatus == "restricted"
        && "restrictedUntil" in get(moderationAccountPath(request.auth.uid)).data
        && get(moderationAccountPath(request.auth.uid)).data.restrictedUntil is timestamp
        && get(moderationAccountPath(request.auth.uid)).data.restrictedUntil <= request.time;
    }

    function canReadAppContent() {
      return hasModerationProjection()
        && (
          get(moderationAccountPath(request.auth.uid)).data.moderationStatus in ["active", "restricted"]
          || moderationRestrictionExpired()
        );
    }

    function canCreateUGC() {
      return hasModerationProjection()
        && (
          get(moderationAccountPath(request.auth.uid)).data.moderationStatus == "active"
          || moderationRestrictionExpired()
        );
    }

    function isAccountActive() {
      return signedIn()
        && hasModerationProjection()
        && get(moderationAccountPath(request.auth.uid)).data.accountStatus == "active"
        && canCreateUGC();
    }

    function isReadableAccount() {
      return signedIn()
        && hasModerationProjection()
        && get(moderationAccountPath(request.auth.uid)).data.accountStatus == "active"
        && canReadAppContent();
    }

    function canReadOwnAccountBootstrap(userID) {
      return signedIn()
        && request.auth.uid == userID
        && canReadAppContent();
    }

    function brandPath(brandID) {
      return /databases/$(database)/documents/brands/$(brandID);
    }

    function totalBrandAdminPath(uid) {
      return /databases/$(database)/documents/brandAdmins/$(uid);
    }

    function isTotalBrandAdmin() {
      return isAccountActive()
        && exists(totalBrandAdminPath(request.auth.uid))
        && get(totalBrandAdminPath(request.auth.uid)).data.isActive == true;
    }

    function brandManagerPath(brandID, uid) {
      return /databases/$(database)/documents/brands/$(brandID)/admins/$(uid);
    }

    function hasBrandManagerAccess(brandID) {
      return isAccountActive()
        && exists(brandManagerPath(brandID, request.auth.uid))
        && get(brandManagerPath(brandID, request.auth.uid)).data.role in ["owner", "admin"];
    }

    function hasBrandWriteAccess(brandID) {
      return signedIn()
        && exists(brandPath(brandID))
        && (isTotalBrandAdmin() || hasBrandManagerAccess(brandID));
    }

    function roomPath(roomID) {
      return /databases/$(database)/documents/Rooms/$(roomID);
    }

    function roomMemberPath(roomID, uid) {
      return /databases/$(database)/documents/Rooms/$(roomID)/members/$(uid);
    }

    function roomDataIsActive(data) {
      return data.isClosed != true
        && (!("lifecycleStatus" in data) || data.lifecycleStatus == "active");
    }

    function roomIsActive(roomID) {
      return exists(roomPath(roomID))
        && roomDataIsActive(get(roomPath(roomID)).data);
    }

    function isRoomParticipant(roomID) {
      return signedIn()
        && roomIsActive(roomID)
        && exists(roomMemberPath(roomID, request.auth.uid));
    }

    function isRoomCreator(roomID) {
      return signedIn()
        && exists(roomPath(roomID))
        && get(roomPath(roomID)).data.creatorUID == request.auth.uid;
    }

    function createsRoomMember(roomID, uid) {
      return isAccountActive()
        && uid == request.auth.uid
        && request.resource.data.userID == uid
        && request.resource.data.role in ["owner", "member"]
        && request.resource.data.keys().hasOnly([
          "userID",
          "role",
          "joinedAt",
          "displayNameSnapshot",
          "avatarPathSnapshot",
          "createdAt",
          "updatedAt"
        ])
        && existsAfter(roomPath(roomID))
        && roomDataIsActive(getAfter(roomPath(roomID)).data)
        && (
          (
            getAfter(roomPath(roomID)).data.creatorUID == uid
            && request.resource.data.role == "owner"
          )
          || (
            getAfter(roomPath(roomID)).data.creatorUID != uid
            && request.resource.data.role == "member"
          )
        );
    }

    function validLastReadSeqUpdate() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(["lastReadSeq", "updatedAt"])
        && request.resource.data.lastReadSeq is int
        && (
          !("lastReadSeq" in resource.data)
          || request.resource.data.lastReadSeq >= resource.data.lastReadSeq
        );
    }

    function validJoinedRoomCreate(userID, roomID) {
      return isAccountActive()
        && request.auth.uid == userID
        && request.resource.data.roomID == roomID
        && request.resource.data.role in ["owner", "member"]
        && request.resource.data.keys().hasOnly([
          "roomID",
          "role",
          "joinedAt",
          "lastReadSeq",
          "isClosed",
          "updatedAt"
        ])
        && existsAfter(roomMemberPath(roomID, userID));
    }

    function validRoomMemberCountUpdate(roomID) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(["memberCount", "updatedAt"])
        && request.resource.data.memberCount is int
        && request.resource.data.memberCount >= 0
        && (
          (
            existsAfter(roomMemberPath(roomID, request.auth.uid))
            && !exists(roomMemberPath(roomID, request.auth.uid))
            && request.resource.data.memberCount == resource.data.memberCount + 1
          )
          || (
            !existsAfter(roomMemberPath(roomID, request.auth.uid))
            && exists(roomMemberPath(roomID, request.auth.uid))
            && request.resource.data.memberCount == resource.data.memberCount - 1
          )
        );
    }

    function roomCreateHasNoDocumentIDFields() {
      return !request.resource.data.keys().hasAny(["ID", "id"]);
    }

    function roomUpdateDoesNotChangeDocumentIDFields() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(["ID", "id"]);
    }

    match /brandAdmins/{adminID} {
      allow read, write: if false;
    }

    match /moderationPrincipals/{principalID} {
      allow read, write: if false;
    }

    match /moderationPrincipalAliases/{aliasID} {
      allow read, write: if false;
    }

    match /moderationAccounts/{userID} {
      allow read, write: if false;
    }

    match /platformAdmins/{adminID} {
      allow read, write: if false;
    }

    match /moderationAuditLogs/{actionID} {
      allow read, write: if false;
    }

    match /moderationUserReports/{document=**} {
      allow read, write: if false;
    }

    match /moderationRoomReports/{document=**} {
      allow read, write: if false;
    }

    match /moderationReportRateLimitBuckets/{bucketID} {
      allow read, write: if false;
    }

    match /moderationAdminRateLimitBuckets/{bucketID} {
      allow read, write: if false;
    }

    match /chatMessageCleanupJobs/{jobID} {
      allow read, write: if false;
    }

    match /moderationRoomCleanupJobs/{jobID} {
      allow read, write: if false;
    }

    match /brandRequests/{requestID} {
      allow read, write: if false;
    }

    match /brandRequestNameIndex/{normalizedBrandNameHash} {
      allow read, write: if false;
    }

    match /brandRequestDailyCounters/{userID}/brandRequestDays/{dateKey} {
      allow read, write: if false;
    }

    match /brandRequestUserLimits/{userID} {
      allow read, write: if false;
    }

    match /lookbookDeletionRequests/{requestID} {
      allow read, write: if false;
    }

    match /lookbookDeletionAuditLogs/{logID} {
      allow read, write: if false;
    }

    match /accountDeletionIntents/{intentID} {
      allow read, write: if false;
    }

    match /accountDeletionRequests/{requestID} {
      allow read, write: if false;
    }

    match /accountDeletionNotificationOutbox/{eventID} {
      allow read, write: if false;
    }

    match /completedDeletionSuppressions/{suppressionID} {
      allow read, write: if false;
    }

    match /accountDeletionAuditLogs/{auditID} {
      allow read, write: if false;
    }

    match /brands/{brandID} {
      allow read: if true;
      allow create, update, delete: if false;

      match /admins/{adminID} {
        allow read, write: if false;
      }

      match /seasons/{seasonID} {
        allow read: if true;
        allow create, update, delete: if false;

        match /posts/{postID} {
          allow read: if true;
          allow create, update: if hasBrandWriteAccess(brandID);
          allow delete: if false;

          match /comments/{commentID} {
            allow read: if true;
            allow create, update, delete: if false;
          }

          match /replacements/{replacementID} {
            allow read: if true;
            allow create, update, delete: if hasBrandWriteAccess(brandID);
          }
        }
      }

      match /importJobs/{jobID} {
        allow read: if hasBrandWriteAccess(brandID);
        allow create, update, delete: if false;
      }

      match /seasonCandidates/{candidateID} {
        allow read: if hasBrandWriteAccess(brandID);
        allow create, update, delete: if false;
      }

      match /seasonDiscoveryJobs/{jobID} {
        allow read: if hasBrandWriteAccess(brandID);
        allow create, update, delete: if false;

        match /candidates/{candidateID} {
          allow read: if hasBrandWriteAccess(brandID);
          allow create, update, delete: if false;
        }

        match /reviews/{reviewID} {
          allow read: if hasBrandWriteAccess(brandID);
          allow create, update, delete: if false;
        }
      }
    }

    match /userIdentities/{identityKey} {
      // 사용자 매핑 컬렉션은 더 이상 사용하지 않고 users/{request.auth.uid}를 canonical 문서로 사용한다.
      allow read, write: if false;
    }

    match /users/{userID} {
      // 신규·재가입 사용자는 문서가 없어도 본인 단일 get으로 onboarding/제재 분기를 판단해야 한다.
      allow get: if canReadOwnAccountBootstrap(userID);
      allow list: if false;
      allow create, update, delete: if false;

      match /postStates/{stateID} {
        allow read: if isReadableAccount() && request.auth.uid == userID;
        allow create, update, delete: if false;
      }

      match /brandStates/{stateID} {
        allow read: if isReadableAccount() && request.auth.uid == userID;
        allow create, update, delete: if false;
      }

      match /seasonStates/{stateID} {
        allow read: if isReadableAccount() && request.auth.uid == userID;
        allow create, update, delete: if false;
      }

      match /commentStates/{stateID} {
        allow read: if isReadableAccount() && request.auth.uid == userID;
        allow create, update, delete: if false;
      }

      match /blockedUsers/{blockedUserID} {
        allow read: if isReadableAccount() && request.auth.uid == userID;
        allow create, update, delete: if false;
      }

      match /roomStates/{roomID} {
        allow read: if isReadableAccount() && request.auth.uid == userID;
        allow create, update, delete: if false;
      }

      match /roomClosureNotices/{roomID} {
        allow read: if signedIn() && request.auth.uid == userID;
        allow delete: if signedIn() && request.auth.uid == userID;
        allow create, update: if false;
      }

      match /joinedRooms/{roomID} {
        allow read: if isReadableAccount() && request.auth.uid == userID;
        allow create: if validJoinedRoomCreate(userID, roomID);
        allow update: if isAccountActive()
          && request.auth.uid == userID
          && validLastReadSeqUpdate();
        allow delete: if isAccountActive()
          && request.auth.uid == userID
          && !existsAfter(roomMemberPath(roomID, userID));
      }

      match /meta/session {
        allow read: if isReadableAccount() && request.auth.uid == userID;
        allow write: if isAccountActive() && request.auth.uid == userID;
      }

      match /devices/{deviceID} {
        allow read: if isReadableAccount() && request.auth.uid == userID;
        allow write: if isAccountActive() && request.auth.uid == userID;
      }

      match /{document=**} {
        allow read, write: if false;
      }
    }

    match /userPublicProfiles/{userID} {
      allow read: if isReadableAccount()
        && exists(userPath(userID))
        && get(userPath(userID)).data.accountStatus == "active";
      allow create, update, delete: if false;
    }

    match /nicknameIndex/{normalizedNicknameHash} {
      allow read, write: if false;
    }

    match /commentReports/{reportID} {
      allow read, write: if false;
    }

    match /Rooms/{roomID} {
      allow read: if isReadableAccount() && roomDataIsActive(resource.data);
      allow create: if isAccountActive()
        && request.resource.data.creatorUID == request.auth.uid
        && !request.resource.data.keys().hasAny(["participantUIDs"])
        && roomCreateHasNoDocumentIDFields()
        && roomDataIsActive(request.resource.data)
        && (!("lifecycleVersion" in request.resource.data)
          || request.resource.data.lifecycleVersion == 1)
        && request.resource.data.keys().hasAll([
          "creatorUID",
          "memberCount",
          "isClosed"
        ]);
      allow update: if isAccountActive()
        && roomUpdateDoesNotChangeDocumentIDFields()
        && (
          (
            isRoomCreator(roomID)
            && !request.resource.data.diff(resource.data).affectedKeys().hasAny([
              "creatorUID",
              "participantUIDs",
              "seq",
              "lastMessage",
              "lastMessageAt",
              "lastMessageSeq",
              "isClosed",
              "lifecycleStatus",
              "lifecycleVersion",
              "closedAt",
              "closureNoticeCode",
              "moderationClosedAt",
              "moderationClosureNoticeCode"
            ])
          )
          || validRoomMemberCountUpdate(roomID)
        );
      allow delete: if false;

      match /Messages/{messageID} {
        allow read: if isReadableAccount() && roomIsActive(roomID);
        allow create, update, delete: if false;
      }

      match /mediaIndex/{mediaID} {
        allow read: if isReadableAccount() && roomIsActive(roomID);
        allow create, update, delete: if false;
      }

      match /members/{uid} {
        allow read: if isRoomParticipant(roomID);
        allow create: if createsRoomMember(roomID, uid);
        allow delete: if isAccountActive()
          && request.auth.uid == uid
          && !isRoomCreator(roomID);
        allow update: if false;
      }

      match /{document=**} {
        allow read: if isRoomParticipant(roomID);
        allow write: if false;
      }
    }

    match /tags/{tagID} {
      allow read: if true;
      allow write: if isAccountActive();
    }

    match /styleMoods/{moodID} {
      allow read: if signedIn()
        && (resource.data.status == "active" || isTotalBrandAdmin());
      allow create, update, delete: if false;
    }

    match /styleMoodTermIndex/{termHash} {
      allow read, write: if false;
    }

    match /styleMoodSeedMetadata/{documentID} {
      allow read, write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
