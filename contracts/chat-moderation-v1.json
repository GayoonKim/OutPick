{
  "contract": "chat-moderation",
  "schemaVersion": 1,
  "status": "accepted",
  "authorities": {
    "accountLifecycle": "users/{uid}.accountStatus",
    "moderationLedger": "moderationPrincipals/{moderationPrincipalID}",
    "currentUIDProjection": "moderationAccounts/{uid}",
    "providerAlias": "moderationPrincipalAliases/{aliasID}",
    "platformAdmin": "platformAdmins/{uid}",
    "globalBlock": "users/{uid}/blockedUsers/{blockedUID}",
    "roomMembership": "Rooms/{roomID}/members/{uid}",
    "roomBan": "Rooms/{roomID}/bans/{moderationPrincipalID}",
    "roomLifecycle": "Rooms/{roomID}.lifecycleStatus",
    "message": "Rooms/{roomID}/Messages/{messageID}",
    "mediaReservation": "Rooms/{roomID}/MediaUploads/{uploadID}",
    "userReport": "moderationUserReports/{targetModerationPrincipalID}",
    "roomReport": "moderationRoomReports/{roomID}",
    "reportRateLimit": "moderationReportRateLimitBuckets/{bucketID}",
    "adminRateLimit": "moderationAdminRateLimitBuckets/{bucketID}",
    "audit": "moderationAuditLogs/{actionID}",
    "messageCleanupJob": "chatMessageCleanupJobs/{jobID}",
    "roomCleanupJob": "moderationRoomCleanupJobs/{roomID}",
    "roomClosureTombstone": "Rooms/{roomID}",
    "legacyRoomClosureNotice": "users/{uid}/roomClosureNotices/{roomID}"
  },
  "identifiers": {
    "moderationPrincipalID": {
      "format": "server-generated opaque Firestore document ID",
      "clientAuthoritative": false
    },
    "aliasID": {
      "format": "v{keyVersion}_{base64url(HMAC-SHA-256(secret, provider + ':' + providerSubject))}",
      "clientAuthoritative": false
    },
    "submissionID": {
      "format": "SHA-256(reporterPrincipalID + ':' + targetType + ':' + targetID + ':' + clientRequestID)",
      "clientAuthoritative": false
    },
    "clientRequestID": {
      "format": "UUID string",
      "maxLength": 64
    }
  },
  "globalBlockVisibility": {
    "direction": "blocked-by-owner only",
    "participantListAndProfile": "unchanged for both users; never reveal the block",
    "directInteraction": "the blocker must unblock first; notify the blocker only",
    "chatCurrentWindow": "messages admitted before block success remain until the room screen session ends",
    "chatNewAdmission": "filter by current blocked UID set without blockedAt comparison",
    "ordering": "hidden messages consume realtime seq and raw pagination cursor",
    "localPayload": "do not retroactively delete GRDB, FTS, attachments, or media cache",
    "secondarySurfaces": "filter search, gallery, reply, user announcement, room preview, banner, unread, and push",
    "systemEvents": "room lifecycle and moderation events remain visible",
    "lookbook": "hide the blocked author's current comments and replies immediately",
    "unblock": "do not force a room reload; future admission is visible and history returns through ordinary reload",
    "bootstrap": "load account snapshot into memory then replace from owner-only server relation; no snapshot plus server failure fails closed",
    "rollout": "latest app and server contract only"
  },
  "enums": {
    "accountStatus": [
      "active",
      "deletionPending"
    ],
    "moderationStatus": [
      "active",
      "restricted",
      "suspended"
    ],
    "reviewState": [
      "open",
      "inReview",
      "resolved",
      "dismissed"
    ],
    "reportTargetType": [
      "user",
      "room"
    ],
    "reportReason": [
      "harassment",
      "hate",
      "sexual",
      "spam",
      "privacy",
      "illegalDangerous",
      "other"
    ],
    "roomLifecycleStatus": [
      "active",
      "closedByOwner",
      "closedByModeration"
    ],
    "roomClosureType": [
      "closedByOwner",
      "closedByModeration"
    ],
    "mediaKind": [
      "images",
      "video"
    ],
    "mediaInspectionStatus": [
      "reserved",
      "uploaded",
      "scanning",
      "ready",
      "rejected",
      "failed",
      "expired"
    ],
    "mediaCleanupStatus": [
      "none",
      "pending",
      "completed",
      "failed"
    ],
    "blockSource": [
      "comment",
      "reply",
      "profile",
      "chat"
    ],
    "moderationAction": [
      "startReview",
      "resolveReview",
      "dismissReview",
      "deleteMessage",
      "temporarilyRestrictAccount",
      "permanentlySuspendAccount",
      "liftAccountModeration",
      "closeRoomByModeration",
      "removeRoomMember",
      "unbanRoomMember"
    ],
    "cleanupJobStatus": [
      "pending",
      "processing",
      "retryPending",
      "awaitingExpiry",
      "completed",
      "failed"
    ]
  },
  "capabilities": {
    "active": {
      "readAppContent": true,
      "createUGC": true,
      "updateUGC": true,
      "deleteOwnUGC": true,
      "createRoom": true,
      "joinRoom": true,
      "moderateOwnedRoom": true,
      "report": true,
      "block": true,
      "unblock": true,
      "support": true,
      "deleteAccount": true
    },
    "restricted": {
      "readAppContent": true,
      "createUGC": false,
      "updateUGC": false,
      "deleteOwnUGC": true,
      "createRoom": false,
      "joinRoom": false,
      "moderateOwnedRoom": false,
      "report": true,
      "block": true,
      "unblock": true,
      "support": true,
      "deleteAccount": true
    },
    "suspended": {
      "readAppContent": false,
      "createUGC": false,
      "updateUGC": false,
      "deleteOwnUGC": false,
      "createRoom": false,
      "joinRoom": false,
      "moderateOwnedRoom": false,
      "report": false,
      "block": false,
      "unblock": false,
      "support": true,
      "deleteAccount": true
    }
  },
  "documents": {
    "moderationPrincipals/{moderationPrincipalID}": {
      "clientRead": false,
      "clientWrite": false,
      "requiredFields": {
        "schemaVersion": "integer:1",
        "moderationStatus": "moderationStatus",
        "restrictedUntil": "timestamp|null",
        "stateVersion": "positive integer",
        "createdAt": "timestamp",
        "updatedAt": "timestamp",
        "expiresAt": "timestamp|null"
      }
    },
    "moderationPrincipalAliases/{aliasID}": {
      "clientRead": false,
      "clientWrite": false,
      "requiredFields": {
        "schemaVersion": "integer:1",
        "moderationPrincipalID": "document ID",
        "provider": "google|apple|kakao",
        "keyVersion": "positive integer",
        "createdAt": "timestamp",
        "expiresAt": "timestamp|null"
      },
      "forbiddenFields": [
        "email",
        "providerSubject",
        "providerToken"
      ]
    },
    "moderationAccounts/{uid}": {
      "clientRead": false,
      "clientWrite": false,
      "requiredFields": {
        "schemaVersion": "integer:2",
        "accountStatus": "active|deletionPending",
        "moderationPrincipalID": "document ID",
        "moderationStatus": "moderationStatus",
        "restrictedUntil": "timestamp|null",
        "stateVersion": "positive integer",
        "updatedAt": "timestamp"
      }
    },
    "platformAdmins/{uid}": {
      "clientRead": false,
      "clientWrite": false,
      "requiredFields": {
        "schemaVersion": "integer:1",
        "isActive": "boolean",
        "createdAt": "timestamp",
        "updatedAt": "timestamp",
        "revokedAt": "timestamp|null"
      }
    },
    "users/{uid}/blockedUsers/{blockedUID}": {
      "clientRead": "owner only",
      "clientWrite": false,
      "requiredFields": {
        "blockerUserID": "owner uid",
        "blockedUserID": "blockedUID",
        "blockedUserNicknameSnapshot": "string|null, max 80 Unicode scalars",
        "source": "blockSource",
        "createdAt": "timestamp",
        "updatedAt": "timestamp"
      }
    },
    "moderationUserReports/{targetModerationPrincipalID}": {
      "clientRead": false,
      "clientWrite": false,
      "requiredFields": {
        "schemaVersion": "integer:1",
        "reviewState": "reviewState",
        "reviewRevision": "non-negative integer",
        "caseVersion": "positive integer",
        "uniqueReporterCount": "non-negative integer",
        "totalSubmissionCount": "non-negative integer",
        "reasonCounts": "map<reportReason, non-negative integer>",
        "priorityClass": "urgent|general",
        "slaDueAt": "timestamp",
        "firstReportedAt": "timestamp",
        "lastReportedAt": "timestamp",
        "updatedAt": "timestamp",
        "expiresAt": "timestamp|null"
      }
    },
    "moderationUserReports/{target}/submissions/{submissionID}": {
      "clientRead": false,
      "clientWrite": false,
      "requiredFields": {
        "schemaVersion": "integer:1",
        "reporterModerationPrincipalID": "document ID",
        "reason": "reportReason",
        "detail": "string|null, max 500 Unicode scalars",
        "roomID": "string|null",
        "triggerMessageID": "string|null",
        "textSnapshot": "string|null, max 4000 UTF-8 bytes",
        "mediaKind": "mediaKind|null",
        "mediaInspectionSummary": "map|null",
        "createdAt": "timestamp",
        "expiresAt": "timestamp|null"
      },
      "forbiddenFields": [
        "mediaCopyPath",
        "email",
        "providerSubject"
      ]
    },
    "moderationUserReports/{target}/reporters/{reporterModerationPrincipalID}": {
      "clientRead": false,
      "clientWrite": false,
      "requiredFields": {
        "schemaVersion": "integer:1",
        "firstReportedAt": "timestamp",
        "lastReportedAt": "timestamp",
        "submissionCount": "positive integer",
        "expiresAt": "timestamp|null"
      }
    },
    "moderationRoomReports/{roomID}": {
      "clientRead": false,
      "clientWrite": false,
      "sameShapeAs": "moderationUserReports/{targetModerationPrincipalID}"
    },
    "moderationRoomReports/{roomID}/submissions/{submissionID}": {
      "clientRead": false,
      "clientWrite": false,
      "sameShapeAs": "moderationUserReports/{target}/submissions/{submissionID}"
    },
    "moderationRoomReports/{roomID}/reporters/{reporterModerationPrincipalID}": {
      "clientRead": false,
      "clientWrite": false,
      "sameShapeAs": "moderationUserReports/{target}/reporters/{reporterModerationPrincipalID}"
    },
    "moderationReportRateLimitBuckets/{bucketID}": {
      "clientRead": false,
      "clientWrite": false,
      "requiredFields": {
        "schemaVersion": "integer:1",
        "reporterModerationPrincipalID": "document ID",
        "minuteBucket": "non-negative integer",
        "acceptedCount": "1...10",
        "updatedAt": "timestamp",
        "expiresAt": "timestamp"
      },
      "forbiddenFields": [
        "detail",
        "textSnapshot",
        "providerSubject",
        "email"
      ]
    },
    "moderationAdminRateLimitBuckets/{bucketID}": {
      "clientRead": false,
      "clientWrite": false,
      "requiredFields": {
        "schemaVersion": "integer:1",
        "actorUID": "uid",
        "kind": "read|mutation",
        "minuteBucket": "non-negative integer",
        "requestCount": "positive integer",
        "updatedAt": "timestamp",
        "expiresAt": "timestamp"
      },
      "forbiddenFields": [
        "reasonCode",
        "reportTargetID",
        "detail",
        "textSnapshot"
      ]
    },
    "Rooms/{roomID}/bans/{moderationPrincipalID}": {
      "clientRead": false,
      "clientWrite": false,
      "requiredFields": {
        "schemaVersion": "integer:1",
        "bannedAt": "timestamp",
        "bannedByUID": "uid",
        "reasonCode": "string",
        "stateVersion": "positive integer",
        "expiresAt": "timestamp|null"
      }
    },
    "Rooms/{roomID}": {
      "moderationExtensionFields": {
        "lifecycleStatus": "roomLifecycleStatus",
        "lifecycleVersion": "positive integer",
        "closedAt": "timestamp|null",
        "closureNoticeCode": "string|null",
        "moderationClosedAt": "timestamp|null",
        "moderationClosureNoticeCode": "string|null"
      },
      "closedTombstone": {
        "schemaVersionField": "tombstoneSchemaVersion: integer:1",
        "clientRead": "current joinedRooms projection owner only",
        "clientWrite": false,
        "retainedFields": "roomName, creatorUID, createdAt, lastMessageAt, memberCount, seq and lifecycle fields",
        "forbiddenFields": "lastMessage, image paths and message content",
        "expiresAt": "closedAt + 14 days; cleanup scheduler due time, not direct Firestore TTL"
      }
    },
    "Rooms/{roomID}/Messages/{messageID}": {
      "moderationExtensionFields": {
        "isDeleted": "boolean",
        "deletedAt": "timestamp|null",
        "message": "removed when isDeleted is true",
        "attachments": "empty or removed when isDeleted is true"
      },
      "invariants": {
        "seq": "immutable positive integer",
        "senderUID": "immutable uid",
        "deletedTombstone": "retained"
      }
    },
    "chatMessageCleanupJobs/{jobID}": {
      "clientRead": false,
      "clientWrite": false,
      "requiredFields": {
        "schemaVersion": "integer:1",
        "roomID": "string",
        "messageID": "string",
        "expectedSeq": "positive integer",
        "storagePrefixes": "bounded server-derived string array",
        "status": "cleanupJobStatus",
        "attempt": "non-negative integer",
        "nextAttemptAt": "timestamp",
        "lastErrorCode": "string|null",
        "createdAt": "timestamp",
        "updatedAt": "timestamp",
        "expiresAt": "timestamp|null"
      },
      "idempotency": "deterministic jobID from roomID + messageID"
    },
    "moderationRoomCleanupJobs/{roomID}": {
      "clientRead": false,
      "clientWrite": false,
      "requiredFields": {
        "schemaVersion": "integer:2",
        "roomID": "string",
        "lifecycleVersion": "positive integer",
        "closureType": "roomClosureType",
        "closureNoticeCode": "string",
        "cleanupPhase": "content|retention",
        "status": "cleanupJobStatus",
        "attempt": "non-negative integer",
        "nextAttemptAt": "timestamp",
        "lastErrorCode": "string|null",
        "createdAt": "timestamp",
        "updatedAt": "timestamp",
        "expiresAt": "timestamp|null"
      },
      "idempotency": "roomID + lifecycleVersion; content cleanup transitions to awaitingExpiry and retention cleanup removes remaining memberships and tombstone"
    },
    "users/{uid}/roomClosureNotices/{roomID}": {
      "clientRead": "owner only",
      "clientCreateOrUpdate": false,
      "clientDelete": "legacy compatibility only",
      "requiredFields": {
        "schemaVersion": "integer:2",
        "roomID": "string",
        "roomName": "optional trimmed string, 1...20 chars",
        "closureType": "roomClosureType",
        "closureNoticeCode": "string",
        "closedAt": "timestamp",
        "expiresAt": "timestamp, closedAt + 30 days"
      },
      "forbiddenFields": [
        "message",
        "attachments",
        "actorUID",
        "reasonCode",
        "reportTargetID"
      ],
      "recipientPolicy": "legacy schema only; Phase 3.1 creates no new per-user notices"
    },
    "moderationAuditLogs/{actionID}": {
      "clientRead": false,
      "clientWrite": false,
      "appendOnly": true,
      "requiredFields": {
        "schemaVersion": "integer:1",
        "actorUID": "uid",
        "action": "moderationAction",
        "targetType": "user|room|message|roomMember",
        "targetID": "string",
        "before": "bounded map|null",
        "after": "bounded map|null",
        "reasonCode": "string",
        "reportTargetType": "reportTargetType|null",
        "reportTargetID": "string|null",
        "requestID": "string",
        "createdAt": "timestamp",
        "expiresAt": "timestamp|null"
      }
    },
    "Rooms/{roomID}/MediaUploads/{uploadID}": {
      "clientRead": false,
      "clientWrite": false,
      "requiredFields": {
        "schemaVersion": "integer:1",
        "clientMutationID": "string",
        "senderUID": "uid",
        "moderationPrincipalID": "document ID",
        "kind": "mediaKind",
        "attachmentCount": "1...30 for images, exactly 1 for video",
        "quarantinePaths": "bounded string array",
        "inspectionStatus": "mediaInspectionStatus",
        "inspectionAttempt": "non-negative integer",
        "inspectionDeadlineAt": "timestamp",
        "inspectionPolicyVersion": "positive integer",
        "inspectionResult": "bounded likelihood map|null",
        "cleanupStatus": "mediaCleanupStatus",
        "createdAt": "timestamp",
        "updatedAt": "timestamp",
        "expiresAt": "timestamp"
      }
    }
  },
  "stateTransitions": {
    "reportReview": {
      "initial": "open",
      "invariants": {
        "reasonCounts": "counts all accepted submissions per reason",
        "uniqueReporterCount": "counts distinct reporter moderation principals",
        "caseVersion": "increments on every accepted submission and every admin mutation",
        "reviewRevision": "increments only when a terminal review reopens because of a new submission"
      },
      "allowed": {
        "open": [
          "inReview",
          "resolved",
          "dismissed"
        ],
        "inReview": [
          "resolved",
          "dismissed"
        ],
        "resolved": [
          "open"
        ],
        "dismissed": [
          "open"
        ]
      },
      "newSubmissionAfterTerminal": {
        "reviewState": "open",
        "increment": [
          "reviewRevision",
          "caseVersion"
        ]
      }
    },
    "mediaInspection": {
      "initial": "reserved",
      "allowed": {
        "reserved": [
          "uploaded",
          "expired"
        ],
        "uploaded": [
          "scanning",
          "expired"
        ],
        "scanning": [
          "ready",
          "rejected",
          "failed"
        ],
        "failed": [
          "scanning",
          "expired"
        ],
        "ready": [],
        "rejected": [],
        "expired": []
      },
      "messageCreation": "only on scanning -> ready",
      "sequenceAllocation": "same transaction as ready message creation",
      "failedSequenceTombstone": false
    }
  },
  "mediaSafetyPolicy": {
    "policyVersion": 1,
    "imageProvider": "Google Cloud Vision SafeSearch",
    "videoProviders": [
      "Google Cloud Video Intelligence Explicit Content Detection",
      "Google Cloud Vision SafeSearch on sampled frames"
    ],
    "thresholds": {
      "adult": "LIKELY",
      "violence": "LIKELY",
      "racy": "VERY_LIKELY"
    },
    "diagnosticOnly": [
      "medical",
      "spoof"
    ],
    "unknownOrProviderFailure": "bounded retry then fail closed",
    "reportEvidenceCopy": false
  },
  "storage": {
    "quarantinePath": "chatModerationQuarantine/{roomID}/{senderUID}/{uploadID}/{objectName}",
    "readyPath": "rooms/{roomID}/{messageID}/{objectName}",
    "quarantineRead": "server only",
    "quarantineWrite": "reservation owner only with exact path/content constraints",
    "readyRead": "authorized room reader and lifecycle/ban checks",
    "readyWrite": "server only",
    "reportEvidencePath": null
  },
  "api": {
    "getMyModerationState": {
      "transport": "Firebase callable",
      "authorization": "authenticated user",
      "request": {},
      "response": {
        "moderationStatus": "moderationStatus",
        "restrictedUntil": "timestamp|null",
        "allowedCapabilities": "string array",
        "noticeReasonCode": "string|null",
        "supportURL": "string|null"
      }
    },
    "submitUserReport": {
      "transport": "Firebase callable",
      "authorization": "active or restricted reporter",
      "request": {
        "targetUID": "uid",
        "reason": "reportReason",
        "detail": "string|null",
        "roomID": "string|null",
        "triggerMessageID": "string|null",
        "clientRequestID": "UUID string"
      },
      "response": {
        "submissionID": "string",
        "deduplicated": "boolean",
        "receivedAt": "timestamp"
      },
      "idempotency": "reporter + user target + clientRequestID",
      "rateLimit": "no daily hard cap; 10 accepted unique submissions per reporter moderation principal per UTC minute; duplicate clientRequestID does not consume quota; RATE_LIMITED includes retryAt"
    },
    "submitRoomReport": {
      "transport": "Firebase callable",
      "authorization": "active or restricted reporter with room context",
      "request": {
        "roomID": "string",
        "reason": "reportReason",
        "detail": "string|null",
        "triggerMessageID": "string|null",
        "clientRequestID": "UUID string"
      },
      "response": {
        "submissionID": "string",
        "deduplicated": "boolean",
        "receivedAt": "timestamp"
      },
      "idempotency": "reporter + room target + clientRequestID",
      "rateLimit": "shares the reporter moderation principal UTC-minute bucket with user reports"
    },
    "blockUser": {
      "transport": "Firebase callable",
      "authorization": "active or restricted user",
      "request": {
        "targetUID": "uid",
        "source": "blockSource",
        "targetNicknameSnapshot": "string|null, max 80 Unicode scalars",
        "clientRequestID": "UUID string"
      },
      "response": {
        "blocked": "true",
        "updatedAt": "timestamp"
      },
      "idempotency": "owner UID + target UID"
    },
    "unblockUser": {
      "transport": "Firebase callable",
      "authorization": "active or restricted user",
      "request": {
        "targetUID": "uid",
        "clientRequestID": "UUID string"
      },
      "response": {
        "blocked": "false",
        "updatedAt": "timestamp"
      },
      "idempotency": "owner UID + target UID"
    },
    "deleteChatMessage": {
      "transport": "Firebase callable",
      "authorization": "author, active room creator, or platform admin",
      "request": {
        "roomID": "string",
        "messageID": "string",
        "expectedSeq": "positive integer",
        "reasonCode": "string|null",
        "reportTargetType": "reportTargetType|null",
        "reportTargetID": "string|null",
        "clientRequestID": "UUID string"
      },
      "response": {
        "messageID": "string",
        "seq": "positive integer",
        "isDeleted": "true",
        "cleanupStatus": "completed|pending",
        "deduplicated": "boolean",
        "deletedAt": "timestamp"
      },
      "idempotency": "actor UID + clientRequestID; a new request for an already deleted message converges without restoring payload"
    },
    "closeOwnedChatRoom": {
      "transport": "Firebase callable",
      "authorization": "active room creator",
      "request": {
        "roomID": "string",
        "expectedLifecycleVersion": "positive integer",
        "clientRequestID": "UUID string"
      },
      "response": {
        "lifecycleStatus": "closedByOwner",
        "cleanupStatus": "completed|pending",
        "lifecycleVersion": "positive integer"
      },
      "idempotency": "owner UID + clientRequestID"
    },
    "acknowledgeRoomClosure": {
      "transport": "Firebase callable",
      "authorization": "authenticated user; room must be closed or already removed",
      "request": {
        "roomID": "string",
        "clientRequestID": "UUID string"
      },
      "response": {
        "roomID": "string",
        "acknowledged": "true",
        "deduplicated": "boolean",
        "clientRequestID": "UUID string"
      },
      "idempotency": "missing membership and joined projection are already acknowledged"
    },
    "removeRoomMember": {
      "transport": "Firebase callable",
      "authorization": "active room creator",
      "request": {
        "roomID": "string",
        "targetUID": "uid",
        "reasonCode": "string",
        "clientRequestID": "UUID string"
      },
      "response": {
        "removed": "true",
        "roomBanned": "true",
        "memberCount": "non-negative integer"
      },
      "idempotency": "roomID + target moderation principal"
    },
    "unbanRoomMember": {
      "transport": "Firebase callable",
      "authorization": "active room creator",
      "request": {
        "roomID": "string",
        "banEntryToken": "opaque room-scoped token returned by listRoomBans",
        "clientRequestID": "UUID string"
      },
      "response": {
        "roomBanned": "false",
        "membershipRestored": "false"
      },
      "idempotency": "roomID + target moderation principal"
    },
    "listRoomBans": {
      "transport": "Firebase callable",
      "authorization": "active room creator",
      "request": {
        "roomID": "string",
        "pageSize": "1...50",
        "cursor": "opaque string|null"
      },
      "response": {
        "items": "safe ban-list item array with room-scoped banEntryToken and public profile summary, without moderationPrincipalID",
        "nextCursor": "opaque string|null"
      }
    },
    "listModerationReports": {
      "transport": "Firebase callable",
      "authorization": "active platform admin",
      "request": {
        "targetType": "reportTargetType",
        "reviewState": "reviewState|null",
        "priorityClass": "urgent|general|null",
        "pageSize": "1...100",
        "cursor": "opaque string|null"
      },
      "response": {
        "items": "safe report summary array",
        "nextCursor": "opaque string|null"
      }
    },
    "getModerationReportDetail": {
      "transport": "Firebase callable",
      "authorization": "active platform admin",
      "request": {
        "targetType": "reportTargetType",
        "targetID": "string",
        "submissionPageSize": "1...100",
        "submissionCursor": "opaque string|null"
      },
      "response": {
