{
  "version": 1,
  "runTimeoutMs": 1000000,
  "inputs": [
    "OutPick",
    "OutPickTests",
    "OutPickUITests",
    "OutPick.xcodeproj",
    "Configurations",
    "scripts/build",
    "LocalSecrets/Firebase/Development/GoogleService-Info.plist",
    "LocalSecrets/Kakao/Development.xcconfig",
    "contracts/brand-operations",
    "tools/verification-gate",
    "verification/brand-request-submit-navigation.json"
  ],
  "checks": [
    {
      "id": "brand-request-submit-state",
      "command": "xcodebuild",
      "args": [
        "test",
        "-project",
        "OutPick.xcodeproj",
        "-scheme",
        "OutPick-Development",
        "-destination",
        "platform=iOS Simulator,name=iPhone 17 Pro,OS=26.2",
        "-parallel-testing-enabled",
        "NO",
        "-derivedDataPath",
        "output/verification-derived-data",
        "CODE_SIGNING_ALLOWED=YES",
        "SWIFT_ACTIVE_COMPILATION_CONDITIONS=$(inherited) OUTPICK_BRAND_LOCAL_INTEGRATION",
        "-only-testing:OutPickTests/BrandOperationsTests/officialURLAndOptionalEnglishNameAreValidatedBeforeSubmission()",
        "-only-testing:OutPickTests/BrandOperationsTests/invalidReceiptLeavesHistoryIndependentAndRetriesOnlyOnUserSubmission()"
      ],
      "cwd": ".",
      "timeoutMs": 300000,
      "kind": "xcresult",
      "requiredTests": [
        "BrandOperationsTests/officialURLAndOptionalEnglishNameAreValidatedBeforeSubmission()",
        "BrandOperationsTests/invalidReceiptLeavesHistoryIndependentAndRetriesOnlyOnUserSubmission()"
      ]
    },
    {
      "id": "brand-request-submit-navigation-ui",
      "command": "xcodebuild",
      "args": [
        "test",
        "-project",
        "OutPick.xcodeproj",
        "-scheme",
        "OutPick-Development",
        "-destination",
        "platform=iOS Simulator,name=iPhone 17 Pro,OS=26.2",
        "-parallel-testing-enabled",
        "NO",
        "-derivedDataPath",
        "output/verification-derived-data",
        "CODE_SIGNING_ALLOWED=NO",
        "-only-testing:OutPickUITests/BrandOperationsUITests/testRequestEntryWithResultsURLFormHistoryAndCompletedNavigation",
        "-only-testing:OutPickUITests/BrandOperationsUITests/testRequestEntryWithoutResultsAndFourStatusHistory",
        "-only-testing:OutPickUITests/BrandOperationsUITests/testSubmissionFailureShowsSingleFriendlyAlertAndKeepsInput",
        "-only-testing:OutPickUITests/BrandOperationsUITests/testLeavingDuringSubmissionDoesNotReplaceAnotherScreen",
        "-only-testing:OutPickUITests/BrandOperationsUITests/testHistoryPageFailureKeepsRowsAndRetriesFromLastCursor"
      ],
      "cwd": ".",
      "timeoutMs": 650000,
      "kind": "xcresult",
      "requiredTests": [
        "BrandOperationsUITests/testRequestEntryWithResultsURLFormHistoryAndCompletedNavigation()",
        "BrandOperationsUITests/testRequestEntryWithoutResultsAndFourStatusHistory()",
        "BrandOperationsUITests/testSubmissionFailureShowsSingleFriendlyAlertAndKeepsInput()",
        "BrandOperationsUITests/testLeavingDuringSubmissionDoesNotReplaceAnotherScreen()",
        "BrandOperationsUITests/testHistoryPageFailureKeepsRowsAndRetriesFromLastCursor()"
      ]
    }
  ]
}
