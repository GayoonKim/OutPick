{
  "version": 1,
  "runTimeoutMs": 600000,
  "inputs": [
    "tools/security",
    ".gitleaks.toml",
    ".local/security-policy.json",
    "tools/verification-gate",
    "verification/secrets-precommit.json",
    "AGENTS.md"
  ],
  "checks": [
    {
      "id": "security-selftests",
      "command": "node",
      "args": [
        "tools/verification-gate/run-node-tests.mjs",
        "tools/security/scan.test.mjs"
      ],
      "cwd": ".",
      "timeoutMs": 120000,
      "kind": "node",
      "nodeMajor": 24,
      "reportNames": [
        "main"
      ],
      "requiredTests": [
        "tools/security/scan.test.mjs::S01 \uc548\uc804\ud55c \ud30c\uc77c\uc740 \uac80\uc0ac\ud558\uace0 \uc778\uc99d \ub9c1\ud06c\uc640 \uae08\uc9c0 \uac12\uc744 \uac80\ucd9c\ud55c\ub2e4",
        "tools/security/scan.test.mjs::S02 \uc791\uc5c5\ud2b8\ub9ac\uc5d0\uc11c \uc9c0\uc6b4 \uac12\ub3c4 index \uc804\uccb4 \uac80\uc0ac\uc5d0\uc11c \uac80\ucd9c\ud55c\ub2e4",
        "tools/security/scan.test.mjs::S03 \ud604\uc7ac \uc0ad\uc81c\ub41c \ube44\ubc00\ub3c4 \uc774\uc804 \uc804\uc1a1 commit\uc5d0\uc11c \uac80\ucd9c\ud55c\ub2e4",
        "tools/security/scan.test.mjs::S04 \ubbf8\uc900\ube44 \ub3c4\uad6c\uc640 \uc815\ucc45 \ubc0f runner \uc624\ub958\ub294 \ucc28\ub2e8\ud55c\ub2e4",
        "tools/security/scan.test.mjs::S05 \ub85c\uadf8\uc640 \uacb0\uacfc\uc5d0 \ube44\ubc00 \uc6d0\ubb38\uc744 \ub0a8\uae30\uc9c0 \uc54a\uace0 \uc2e4\ud328\uc640 0600\uc744 \ubcf4\uc874\ud55c\ub2e4",
        "tools/security/scan.test.mjs::S06 symlink \ubbf8\ubd84\ub958 binary\uc640 \ub113\uc740 \uc608\uc678 \uc815\ucc45\uc744 \uac70\ubd80\ud55c\ub2e4"
      ]
    },
    {
      "id": "secret-candidate",
      "command": "node",
      "args": [
        "tools/security/scan.mjs",
        "--mode",
        "candidate"
      ],
      "cwd": ".",
      "timeoutMs": 180000,
      "kind": "command",
      "nodeMajor": 24
    },
    {
      "id": "secret-index",
      "command": "node",
      "args": [
        "tools/security/scan.mjs",
        "--mode",
        "index"
      ],
      "cwd": ".",
      "timeoutMs": 180000,
      "kind": "command",
      "nodeMajor": 24
    }
  ]
}
