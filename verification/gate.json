{
  "version": 1,
  "runTimeoutMs": 900000,
  "inputs": [
    "verification",
    "tools/verification-gate",
    "Socket",
    "scripts",
    "AGENTS.md"
  ],
  "checks": [
    {
      "id": "gate-selftest",
      "command": "node",
      "args": [
        "--test",
        "tools/verification-gate/gate.test.mjs"
      ],
      "cwd": ".",
      "timeoutMs": 120000,
      "kind": "command"
    },
    {
      "id": "firebase-config-test",
      "command": "sh",
      "args": [
        "scripts/build/test-validate-and-copy-firebase-config.sh"
      ],
      "cwd": ".",
      "timeoutMs": 120000,
      "kind": "command"
    },
    {
      "id": "socket-check",
      "command": "npm",
      "args": [
        "--prefix",
        "Socket",
        "run",
        "check"
      ],
      "cwd": ".",
      "timeoutMs": 300000,
      "kind": "command"
    },
    {
      "id": "socket-test",
      "command": "npm",
      "args": [
        "--prefix",
        "Socket",
        "test"
      ],
      "cwd": ".",
      "timeoutMs": 300000,
      "kind": "node",
      "reportNames": [
        "main"
      ],
      "requiredTests": [
        "Socket/test/runtime/rateLimiter.test.js::rate limiter는 key와 window별 요청 수를 제한한다",
        "Socket/test/media/directMediaUploadService.test.js::묶음 크기에 맞춰 전체 객체 확인 후 한번만 확정한다",
        "Socket/test/media/mediaDeliveryWatcher.test.js::pending delivery는 lease 후 기존 media event와 push를 보내고 completed가 된다",
        "Socket/test/messages/messagePayload.test.js::답장 미디어 만료 시각은 대상 서버 메시지에서만 가져온다"
      ]
    }
  ]
}
