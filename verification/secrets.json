{
  "version": 1,
  "runTimeoutMs": 600000,
  "inputs": [
    "tools/security",
    ".gitleaks.toml",
    ".local/security-policy.json",
    "tools/verification-gate",
    "verification/secrets.json",
    "AGENTS.md"
  ],
  "checks": [
    {
      "id": "security-selftests",
      "command": "node",
      "args": [
        "tools/verification-gate/run-node-tests.mjs",
        "tools/security/scan.test.mjs"
      ],
      "cwd": ".",
      "timeoutMs": 120000,
      "kind": "node",
      "nodeMajor": 24,
      "reportNames": [
        "main"
      ],
      "requiredTests": [
        "tools/security/scan.test.mjs::S01 안전한 파일은 검사하고 인증 링크와 금지 값을 검출한다",
        "tools/security/scan.test.mjs::S02 작업트리에서 지운 값도 index 전체 검사에서 검출한다",
        "tools/security/scan.test.mjs::S03 현재 삭제된 비밀도 이전 전송 commit에서 검출한다",
        "tools/security/scan.test.mjs::S04 미준비 도구와 정책 및 runner 오류는 차단한다",
        "tools/security/scan.test.mjs::S05 로그와 결과에 비밀 원문을 남기지 않고 실패와 0600을 보존한다",
        "tools/security/scan.test.mjs::S06 symlink 미분류 binary와 넓은 예외 정책을 거부한다"
      ]
    },
    {
      "id": "secret-candidate",
      "command": "node",
      "args": [
        "tools/security/scan.mjs",
        "--mode",
        "candidate"
      ],
      "cwd": ".",
      "timeoutMs": 180000,
      "kind": "command",
      "nodeMajor": 24
    },
    {
      "id": "secret-index",
      "command": "node",
      "args": [
        "tools/security/scan.mjs",
        "--mode",
        "index"
      ],
      "cwd": ".",
      "timeoutMs": 180000,
      "kind": "command",
      "nodeMajor": 24
    },
    {
      "id": "secret-history",
      "command": "node",
      "args": [
        "tools/security/scan.mjs",
        "--mode",
        "history",
        "--ref",
        "1c07a7fa28b5aafb2d8562d514706ec072bb43b1..HEAD"
      ],
      "cwd": ".",
      "timeoutMs": 180000,
      "kind": "command",
      "nodeMajor": 24
    }
  ]
}
