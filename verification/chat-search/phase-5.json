{
  "version": 1,
  "runTimeoutMs": 4200000,
  "inputs": [
    "verification",
    "tools/verification-gate",
    "contracts/chat-search",
    "OutPick",
    "OutPickTests",
    "OutPickUITests",
    "OutPick.xcodeproj",
    "Configurations",
    "LocalSecrets/Firebase/Development/GoogleService-Info.plist",
    "AGENTS.md"
  ],
  "checks": [
    {
      "id": "firebase-config-test",
      "command": "sh",
      "args": [
        "scripts/build/test-validate-and-copy-firebase-config.sh"
      ],
      "cwd": ".",
      "timeoutMs": 120000,
      "kind": "command"
    },
    {
      "id": "chat-search-ios",
      "command": "xcodebuild",
      "args": [
        "test",
        "-project",
        "OutPick.xcodeproj",
        "-scheme",
        "OutPick-Development",
        "-destination",
        "platform=iOS Simulator,name=iPhone 17 Pro,OS=26.2",
        "-only-testing:OutPickTests/AppRuntimeConfigurationTests",
        "-only-testing:OutPickTests/KeyboardDismissSupportTests",
        "-only-testing:OutPickTests/ChatMessageSearchIndexTests",
        "-only-testing:OutPickTests/ChatSearchRepositoryTests",
        "-only-testing:OutPickTests/GRDBChatSearchStoreTests",
        "-only-testing:OutPickTests/AppDatabaseMigrationTests",
        "-only-testing:OutPickTests/GRDBChatDeletionSyncStoreTests",
        "-only-testing:OutPickTests/AccountDeletionLocalDataCleanupTests",
        "-only-testing:OutPickTests/GRDBChatRoomLocalDataStoreTests",
        "-only-testing:OutPickTests/ChatSearchSessionTests",
        "-only-testing:OutPickTests/ChatSearchFallbackTests",
        "-only-testing:OutPickTests/ChatSearchVisibilityTests",
        "-only-testing:OutPickTests/UserBlockSessionControllerTests",
        "-only-testing:OutPickTests/ChatSearchNavigationTests",
        "-only-testing:OutPickTests/ChatMessagePageLoaderTests",
        "-only-testing:OutPickTests/ChatReadStateStoreTests",
        "-only-testing:OutPickTests/ChatRoomReadStateStoreTests",
        "-only-testing:OutPickTests/ChatRoomViewModelMessageActionTests",
        "-parallel-testing-enabled",
        "NO",
        "-derivedDataPath",
        "output/verification-derived-data",
        "CODE_SIGNING_ALLOWED=NO"
      ],
      "cwd": ".",
      "timeoutMs": 1800000,
      "kind": "xcresult",
      "requiredTests": [
        "AppRuntimeConfigurationTests/developmentConfigurationAcceptsOnlyDevelopmentBoundaries()",
        "AppRuntimeConfigurationTests/productionConfigurationRequiresCanonicalSocket()",
        "AppRuntimeConfigurationTests/developmentRejectsProductionSocket()",
        "AppRuntimeConfigurationTests/developmentRejectsProductionSocketURLVariants()",
        "AppRuntimeConfigurationTests/developmentRequiresCanonicalSocket()",
        "AppRuntimeConfigurationTests/productionRejectsCanonicalSocketVariant()",
        "AppRuntimeConfigurationTests/firebaseBundleAndProjectMustMatchRuntimeEnvironment()",
        "AppRuntimeConfigurationTests/developmentRejectsProductionFirebaseProject()",
        "AppRuntimeConfigurationTests/productionRejectsDevelopmentFirebaseProject()",
        "AppRuntimeConfigurationTests/googleCallbackMustMatchFirebasePlist()",
        "AppRuntimeConfigurationTests/kakaoCallbackMustMatchNativeAppKey()",
        "AppRuntimeConfigurationTests/developmentRejectsProductionKakaoConfiguration()",
        "AppRuntimeConfigurationTests/productionRejectsDevelopmentKakaoConfiguration()",
        "KeyboardDismissSupportTests/excludesChatSendButtonFromWindowDismissal()",
        "KeyboardDismissSupportTests/excludesChatSendButtonDescendantFromWindowDismissal()",
        "KeyboardDismissSupportTests/preservesTextInputTouches()",
        "KeyboardDismissSupportTests/continuesReceivingConversationBackgroundTouches()",
        "ChatMessageSearchIndexTests/sharedV2FixturesMatchExpectedNormalizationTokensAndContains()",
        "ChatMessageSearchIndexTests/pinnedUnicodeCorpusAndLocaleIndependenceHold()",
        "ChatMessageSearchIndexTests/everyLiteralMatchHasCandidateTokenAndNormalizationIsIdempotent()",
        "ChatMessageSearchIndexTests/sessionContractSeparatesScopeCountAndLifetime()",
        "ChatSearchRepositoryTests/serverOnlyPagesRejectCacheMalformedDataAndWrongIndexVersion()",
        "ChatSearchRepositoryTests/queryUsesBoundedLimitUpperSequenceAndExclusiveRawCursor()",
        "GRDBChatSearchStoreTests/failedPageCommitRollsBackHitsAndCursor()",
        "GRDBChatSearchStoreTests/generalMessagePruningPreservesSearchHits()",
        "GRDBChatSearchStoreTests/cleanupRejectsLateWritesAcrossSessionRoomAndAccount()",
        "GRDBChatSearchStoreTests/migrationAndRestartRemoveOnlyTransientSearchData()",
        "GRDBChatSearchStoreTests/resultWindowsAndDeletionEnumerationStayBounded()",
        "GRDBChatSearchStoreTests/searchOnlyHitsParticipateInDeletionRecoveryAndDuplicateScrubbing()",
        "GRDBChatSearchStoreTests/deletionMarkerWinsAgainstLateCandidatePage()",
        "GRDBChatSearchStoreTests/visibilityRevisionRejectsBothWriteOrdersAndRollsBackOnFailure()",
        "AppDatabaseMigrationTests/senderUIDRebuilderRemovesLegacySenderIDAndBackfillsValidRows()",
        "AppDatabaseMigrationTests/freshDatabaseAppliesTwentySevenMigrationsWithoutLegacyColumns()",
        "AccountDeletionLocalDataCleanupTests/deletesEveryUserScopedGRDBTable()",
        "GRDBChatDeletionSyncStoreTests/applyScrubsMessageReplySearchMediaAndOutboxAtomically()",
        "GRDBChatDeletionSyncStoreTests/revisionGapRollsBackScrubAndCursor()",
        "GRDBChatDeletionSyncStoreTests/socketRevisionArrivingDuringPageFetchIsIncludedInSameReconciliation()",
        "GRDBChatRoomLocalDataStoreTests/transientCleanupKeepsOutboxAndProfileCache()",
        "GRDBChatRoomLocalDataStoreTests/exitCleanupDeletesOutboxAndPrunesOnlyOrphanUsers()",
        "GRDBChatRoomLocalDataStoreTests/exitCleanupFailureRollsBackAllRoomDeletes()",
        "ChatSearchSessionTests/navigationAndExactCountShareOneScanAndCommitEachPageOnce()",
        "ChatSearchSessionTests/firstHitPublishesBeforeExhaustionWithoutPrematureZeroCount()",
        "ChatSearchSessionTests/replacementAndCancellationDiscardStaleResponsesAndNextRequests()",
        "ChatSearchSessionTests/backgroundPausesNewWorkAndForegroundRevalidatesBeforeResume()",
        "ChatSearchSessionTests/errorsResumeOnlyAllowedCursorWithoutAutomaticRetryLoop()",
        "ChatSearchFallbackTests/offlineAndMidScanFallbackUseOneLocalGenerationAndLiteralScope()",
        "ChatSearchFallbackTests/accessLossStopsSearchWithoutLocalBypass()",
        "ChatSearchFallbackTests/reconnectionWaitsForManualResearchAndPreservesLocalSelection()",
        "ChatSearchVisibilityTests/blockPublicationFenceRejectsStaleResultsAndJumpCompletions()",
        "ChatSearchVisibilityTests/reversedSnapshotsUnblockAndAccountEpochNeverRestoreInvalidHits()",
        "ChatSearchVisibilityTests/visibilityWriteFailureHidesResultsUntilLatestSnapshotCommits()",
        "UserBlockSessionControllerTests/bootstrapUsesCacheThenReplacesWithServerSnapshot()",
        "UserBlockSessionControllerTests/bootstrapFailsClosedWithoutCache()",
        "UserBlockSessionControllerTests/successfulMutationUpdatesMemoryAndAccountSnapshot()",
        "UserBlockSessionControllerTests/staleBootstrapFailureDoesNotClearNewAccountVisibility()",
        "ChatSearchNavigationTests/rapidArrowsCoalesceAndOnlyLatestSuccessfulJumpCommitsOrdinal()",
        "ChatSearchNavigationTests/loadOrSnapshotFailureKeepsValidSelectionAndRejectsStaleCompletion()",
        "ChatSearchNavigationTests/stateRenderingSeparatesScanningEmptyLocalErrorAndUnselected()",
        "ChatSearchNavigationTests/searchWindowNeverAdvancesReadFrontier()",
        "ChatSearchNavigationTests/fallbackDeletionAndBlockChooseDeterministicValidNeighbor()",
        "ChatMessagePageLoaderTests/offlineKeepsLocalRowsAndReconnectRepairsOnlyMissingRanges()",
        "ChatMessagePageLoaderTests/oneFailedRangeKeepsOtherSuccessAndStopsCursor()",
        "ChatReadStateStoreTests/visibleCandidateCannotCrossUnprovenGapOrMoveBackward()",
        "ChatReadStateStoreTests/frontierFinalSeqDoesNotDependOnLoadedWindowMax()",
        "ChatRoomReadStateStoreTests/markReadFlushedKeepsLastReadSeqMonotonic()"
      ]
    }
  ]
}
