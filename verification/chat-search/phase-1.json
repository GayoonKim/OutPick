{
  "version": 1,
  "runTimeoutMs": 3000000,
  "inputs": [
    "verification", "tools/verification-gate", "contracts/chat-search", "Socket",
    "firestore-tests", "functions", "OutPick", "OutPickTests", "OutPickUITests",
    "OutPick.xcodeproj", "Configurations", "scripts",
    "LocalSecrets/Firebase/Development/GoogleService-Info.plist",
    "firestore.rules", "firestore.indexes.json", "storage.rules",
    "storage.chat-media-quarantine.rules", "storage.moderation-evidence.rules",
    "firebase.json", "AGENTS.md"
  ],
  "checks": [
    {
      "id": "gate-selftest", "command": "node",
      "args": ["--test", "tools/verification-gate/gate.test.mjs"],
      "cwd": ".", "timeoutMs": 120000, "kind": "command", "nodeMajor": 24
    },
    {
      "id": "firebase-config-test", "command": "sh",
      "args": ["scripts/build/test-validate-and-copy-firebase-config.sh"],
      "cwd": ".", "timeoutMs": 120000, "kind": "command"
    },
    {
      "id": "socket-check", "command": "npm",
      "args": ["--prefix", "Socket", "run", "check"],
      "cwd": ".", "timeoutMs": 300000, "kind": "command", "nodeMajor": 24
    },
    {
      "id": "socket-test", "command": "npm",
      "args": ["--prefix", "Socket", "test"],
      "cwd": ".", "timeoutMs": 300000, "kind": "node", "nodeMajor": 24,
      "reportNames": ["main"],
      "requiredTests": [
        "Socket/test/runtime/rateLimiter.test.js::rate limiter는 key와 window별 요청 수를 제한한다",
        "Socket/test/media/directMediaUploadService.test.js::묶음 크기에 맞춰 전체 객체 확인 후 한번만 확정한다",
        "Socket/test/media/mediaDeliveryWatcher.test.js::pending delivery는 lease 후 기존 media event와 push를 보내고 completed가 된다",
        "Socket/test/messages/messagePayload.test.js::답장 미디어 만료 시각은 대상 서버 메시지에서만 가져온다",
        "Socket/test/messages/messageSearchIndex.test.js::공통 v2 fixture의 정규화와 token이 일치한다",
        "Socket/test/messages/messageSearchIndex.test.js::고정 Unicode 매핑과 정규화 corpus를 통과한다"
      ]
    },
    {
      "id": "chat-search-ios", "command": "xcodebuild",
      "args": [
        "test", "-project", "OutPick.xcodeproj", "-scheme", "OutPick-Development",
        "-destination", "platform=iOS Simulator,name=iPhone 17 Pro,OS=26.2",
        "-only-testing:OutPickTests/AppRuntimeConfigurationTests",
        "-only-testing:OutPickTests/KeyboardDismissSupportTests",
        "-only-testing:OutPickTests/ChatMessageSearchIndexTests",
        "-parallel-testing-enabled", "NO", "-derivedDataPath",
        "output/verification-derived-data", "CODE_SIGNING_ALLOWED=NO"
      ],
      "cwd": ".", "timeoutMs": 1800000, "kind": "xcresult",
      "requiredTests": [
        "AppRuntimeConfigurationTests/developmentConfigurationAcceptsOnlyDevelopmentBoundaries()",
        "AppRuntimeConfigurationTests/productionConfigurationRequiresCanonicalSocket()",
        "AppRuntimeConfigurationTests/developmentRejectsProductionSocket()",
        "AppRuntimeConfigurationTests/developmentRejectsProductionSocketURLVariants()",
        "AppRuntimeConfigurationTests/developmentRequiresCanonicalSocket()",
        "AppRuntimeConfigurationTests/productionRejectsCanonicalSocketVariant()",
        "AppRuntimeConfigurationTests/firebaseBundleAndProjectMustMatchRuntimeEnvironment()",
        "AppRuntimeConfigurationTests/developmentRejectsProductionFirebaseProject()",
        "AppRuntimeConfigurationTests/productionRejectsDevelopmentFirebaseProject()",
        "AppRuntimeConfigurationTests/googleCallbackMustMatchFirebasePlist()",
        "AppRuntimeConfigurationTests/kakaoCallbackMustMatchNativeAppKey()",
        "AppRuntimeConfigurationTests/developmentRejectsProductionKakaoConfiguration()",
        "AppRuntimeConfigurationTests/productionRejectsDevelopmentKakaoConfiguration()",
        "KeyboardDismissSupportTests/excludesChatSendButtonFromWindowDismissal()",
        "KeyboardDismissSupportTests/excludesChatSendButtonDescendantFromWindowDismissal()",
        "KeyboardDismissSupportTests/preservesTextInputTouches()",
        "KeyboardDismissSupportTests/continuesReceivingConversationBackgroundTouches()",
        "ChatMessageSearchIndexTests/sharedV2FixturesMatchExpectedNormalizationTokensAndContains()",
        "ChatMessageSearchIndexTests/pinnedUnicodeCorpusAndLocaleIndependenceHold()",
        "ChatMessageSearchIndexTests/everyLiteralMatchHasCandidateTokenAndNormalizationIsIdempotent()",
        "ChatMessageSearchIndexTests/sessionContractSeparatesScopeCountAndLifetime()"
      ]
    }
  ]
}
