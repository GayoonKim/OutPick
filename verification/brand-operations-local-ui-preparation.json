{
  "version": 1,
  "runTimeoutMs": 900000,
  "inputs": [
    "OutPick",
    "OutPickTests",
    "OutPick.xcodeproj",
    "contracts/brand-operations",
    "tools/brand-operations",
    "tools/verification-gate",
    "verification/brand-operations-local-ui-preparation.json"
  ],
  "checks": [
    {
      "id": "local-ui-preparation",
      "command": "xcodebuild",
      "args": [
        "test",
        "-project",
        "OutPick.xcodeproj",
        "-scheme",
        "OutPick-Development",
        "-destination",
        "platform=iOS Simulator,name=iPhone 17 Pro,OS=26.2",
        "-parallel-testing-enabled",
        "NO",
        "-derivedDataPath",
        "output/verification-derived-data",
        "CODE_SIGNING_ALLOWED=YES",
        "SWIFT_ACTIVE_COMPILATION_CONDITIONS=$(inherited) OUTPICK_BRAND_LOCAL_INTEGRATION",
        "-only-testing:OutPickTests/BrandOperationsTests",
        "-only-testing:OutPickTests/BrandOperationsL151Tests",
        "-only-testing:OutPickTests/BrandLocalIntegrationPreparationTests",
        "-only-testing:OutPickTests/CloudFunctionsBrandRequestRepositoryTests",
        "-only-testing:OutPickTests/BrandLocalUIPreparationTests"
      ],
      "cwd": ".",
      "timeoutMs": 850000,
      "kind": "xcresult",
      "requiredTests": [
        "BrandLocalIntegrationPreparationTests/testDedicatedModeDoesNotConfigureDefaultFirebaseApp()",
        "BrandLocalIntegrationPreparationTests/testOnlyCompleteLocalTargetIsAccepted()",
        "BrandLocalIntegrationPreparationTests/testRemoteMixedOrMalformedHostsFailBeforeSDKCreation()",
        "BrandLocalIntegrationPreparationTests/testWrongProjectRegionMissingFunctionsAndSharedPortsFailClosed()",
        "BrandOperationsL151Tests/publicResponseFixtures42PassThroughRepositoryAndRejectDamage()",
        "BrandOperationsL151Tests/requiredTypesDatesReasonsAndScopeAreStrict()",
        "BrandOperationsL151Tests/publicErrorFixtures9UseCodeAndOptionalReasonWithoutLosingDraft()",
        "BrandOperationsL151Tests/originalResourceExhaustedDetailsAreOptInAndOtherCallsKeepLegacyError()",
        "BrandOperationsL151Tests/emptyContinuationFailureKeepsRowsAndLastConsumedCursorForRetry()",
        "BrandOperationsL151Tests/initialEmptyPagesContinueAndRepeatedCursorFailsWithoutEnding()",
        "BrandOperationsL151Tests/malformedNextPageRetainsRowsAndSuccessfulCursor()",
        "BrandOperationsL151Tests/typedPageInputsForwardValuesAndServerValidationErrors()",
        "BrandOperationsTests/officialURLAndOptionalEnglishNameAreValidatedBeforeSubmission()",
        "BrandOperationsTests/invalidReceiptLeavesHistoryIndependentAndRetriesOnlyOnUserSubmission()",
        "BrandOperationsTests/transportFailuresPreserveDraftAndDoNotRetryAutomatically()",
        "BrandOperationsTests/repositoryHistoryMapsFourStatesAndRoutesOnlyCurrentPublicCompletion()",
        "BrandOperationsTests/repositoryPaginationRetriesTheSameCursorWithoutLosingLoadedRows()",
        "BrandOperationsTests/inputBoundariesAndSchemeDefaultFollowPublicContract()",
        "BrandOperationsTests/receiptRejectsMissingUnknownAndMalformedValues()",
        "BrandOperationsTests/lostOrInvalidResponseKeepsInputsAndOnlyManualRetrySendsAgain()",
        "BrandOperationsTests/submissionErrorsHideTechnicalDetailsAndDismissWithoutLosingDraft()",
        "BrandOperationsTests/submissionLimitAndRestrictionKeepActionableMessages()",
        "BrandOperationsTests/fourStatusesHoldReasonAndNullableCompletionArePreserved()",
        "BrandOperationsTests/completedNavigationRechecksPublicBrandAndNullNeverRoutes()",
        "BrandOperationsTests/submissionCompletionRoutesOnlyWhenPublicIDIsPresent()",
        "BrandOperationsTests/scopeSwitchCancelsOldTaskAndDiscardsLatePage()",
        "BrandOperationsTests/paginationDeduplicatesAndKeepsAlreadyLoadedRowsOnFailure()",
        "BrandOperationsTests/publicationDTORejectsMissingUnknownPendingAndDeletedStates()",
        "BrandOperationsTests/publicBrandUseCasePropagatesReadErrorsWithoutEmptySuccess()",
        "BrandOperationsTests/likedBrandsExcludePendingAndPropagateReadFailure()",
        "BrandOperationsTests/brandCardsAndHeaderMakeZeroImageRequestsWhileSeasonAndLookbookLoad()",
        "CloudFunctionsBrandRequestRepositoryTests/coversBrandRequestCallableContracts()",
        "BrandOperationsTests/newAndExistingBrandSharesHaveNoDisplayImageAndKeepStoredSnapshot()",
        "BrandLocalUIPreparationTests/matchingFourLocalServicesAreAcceptedWithoutSDKCreation()",
        "BrandLocalUIPreparationTests/mixedStorageRoundSourceOrRemoteEndpointFailsClosed()",
        "BrandLocalUIPreparationTests/onlyHistoryCallablePassesAndMutationsNeverReachSDK()",
        "BrandLocalUIPreparationTests/historyErrorsAreNotReplacedBySuccessfulEmptyRows()",
        "BrandLocalUIPreparationTests/unregisteredEnvironmentStopsBeforeDefaultSDKCreation()",
        "BrandLocalUIPreparationTests/approvedDeviceRelayMapsFourServicesWithoutChangingLoopbackParser()",
        "BrandLocalUIPreparationTests/deviceRelayRejectsWrongScopePeerRoundSourceTenantAndDigest()",
        "BrandLocalUIPreparationTests/deviceRelayRejectsRemoteLoopbackMalformedAndOverlappingEndpoints()",
        "BrandLocalUIPreparationTests/historyFailureEvidenceExcludesCredentialsAndPreservesError()",
        "BrandLocalUIPreparationTests/deviceHTTPSRejectsVersionBaseOrCertificateMismatch()",
        "BrandLocalUIPreparationTests/deviceHTTPSRejectsExpiredOrMalformedTLSMetadata()"
      ]
    }
  ]
}
